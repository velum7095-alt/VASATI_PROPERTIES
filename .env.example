# ==============================================================================
# BANGALORE REAL ESTATE — DPDP ACT 2023 & IT ACT 2000 ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bangalore_realestate?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# DPDP Act 2023 Compliance — Field-level AES-256-GCM Encryption Key at Rest
# Must be 32 bytes (64 hex characters)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Blind Index Lookup Salt (Separated from encryption key for defense-in-depth)
FIELD_LOOKUP_SALT="change_this_to_a_random_salt_for_blind_index_lookups"

# IP Hashing Salt (SHA-256 with Salt to prevent IP reconstruction)
IP_HASH_SALT="change_this_to_a_random_salt_for_ip_pseudonymization"

# Admin Authentication & Session Secret
ADMIN_SESSION_SECRET="change_this_to_a_strong_jwt_or_session_secret_at_least_32_chars"
ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="ChangeMeInProduction#2026!"

# Business Identity & Regulatory Placeholders
# NOTE: Replace all [PLACEHOLDER] values with verified business entity details
NEXT_PUBLIC_BUSINESS_NAME="[BUSINESS_NAME_PLACEHOLDER]"
NEXT_PUBLIC_BUSINESS_LEGAL_ENTITY="[LEGAL_ENTITY_NAME_PVT_LTD]"
NEXT_PUBLIC_BUSINESS_ADDRESS="[REGISTERED_OFFICE_ADDRESS_BANGALORE_KARNATAKA]"
NEXT_PUBLIC_BUSINESS_PHONE="+91 80 [PHONE_PLACEHOLDER]"
NEXT_PUBLIC_BUSINESS_EMAIL="contact@[BUSINESS_DOMAIN].com"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# Karnataka RERA Registration Placeholders
NEXT_PUBLIC_AGENCY_KRERA_NO="PRM/KA/RERA/1251/[YEAR]/AG/[NUMBER_PLACEHOLDER]"

# Statutory Grievance Redressal Officer (Mandated under DPDP Act 2023 & IT Rules 2021)
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME="[GRIEVANCE_OFFICER_NAME_PLACEHOLDER]"
NEXT_PUBLIC_GRIEVANCE_OFFICER_DESIGNATION="Grievance Redressal Officer & Data Protection Lead"
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL="grievance@[BUSINESS_DOMAIN].com"
NEXT_PUBLIC_GRIEVANCE_OFFICER_PHONE="+91 80 [PHONE_PLACEHOLDER]"
NEXT_PUBLIC_GRIEVANCE_RESPONSE_TIMELINE="7 working days"

# Data Retention Policy
LEAD_RETENTION_MONTHS="12"
CONSENT_LOG_RETENTION_MONTHS="60"

# Optional Cloudflare Turnstile / hCaptcha (Bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Optional Privacy Analytics (Self-hosted Umami / Plausible or None)
NEXT_PUBLIC_ANALYTICS_URL=""
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=""

